vunit psl_vunit_vu (ex2(beh)) {
  -- Enter your code here

  -- pi never high b2b @clk1
  assert never {pi; pi} @clk1;

  -- po never high b2b @clk2
  assert never {po; po} @clk2;

  -- after pi no pi until prior po
  assert always (pi ->
                      (next (not pi until po) @clk2)
                ) @clk1;

  -- after pi po
  assert always (pi ->
                      (eventually! po) @clk2
                ) @clk1;

  -- after pi next 2 cycles of clk2 need low po
  assert always (pi ->
                        (next_a[0 to 2] (not po) @clk2)
                )@clk1;
  }
